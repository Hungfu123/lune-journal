# Kein HTTPS hier: in Produktion terminiert der Nginx der Softball-App TLS
# und reicht an diesen Container weiter (siehe deploy/nginx-lune.conf).
:80 {
	header X-Robots-Tag "noindex, nofollow"

	# Live-Kanal (Server-Sent Events) — bewusst ohne `encode`: die Kompression
	# sammelt Daten, bis ihr Puffer voll ist, und hielte die Ereignisse zurück.
	handle /api/stream {
		reverse_proxy api:8000
	}

	# API
	handle /api/* {
		encode zstd gzip
		reverse_proxy api:8000
	}

	# Teilen-Ziel: normalerweise fängt der Service Worker den POST im Browser ab
	# und der Server sieht ihn nie. Fehlt er (frisch installiert, Cache geleert),
	# soll trotzdem die App aufgehen statt ein nacktes "405 Method Not Allowed".
	handle /share {
		redir / 303
	}

	# Fotos: Caddy fragt vor jeder Datei die API, ob ihr angemeldet seid
	handle /media/* {
		forward_auth api:8000 {
			uri /api/auth/check
		}
		header Cache-Control "private, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	# Service Worker nie cachen, damit Updates sofort ankommen
	handle /sw.js {
		encode gzip
		header Cache-Control "no-cache"
		root * /srv/app
		file_server
	}

	# App
	handle {
		encode zstd gzip
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
